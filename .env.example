# Copy this file to .env and fill in the three values. Never commit .env.
#   cp .env.example .env

# The SecureAI Guard: the URL and the team token from the organisers.
GUARD_URL=https://the-url-from-the-organisers
GUARD_TOKEN=sai_your-team-token

# The LLM key from the challenge brief.
OPENAI_API_KEY=the-llm-key-from-the-challenge-brief

# Optional. The default is gpt-4o-mini.
# OPENAI_MODEL=gpt-4o-mini
